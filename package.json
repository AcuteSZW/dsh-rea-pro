{
  "name": "dsh-rea-pro",
  "version": "1.0.4",
  "description": "Mount REA's reverse-engineering toolset as MCP tools in DeepSeek Harness, with a composer chip that switches it on for the sessions that need it (off after install).",
  "type": "module",
  "license": "MIT",
  "author": "AcuteSZW",
  "homepage": "https://github.com/AcuteSZW/dsh-rea-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AcuteSZW/dsh-rea-pro.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "rea",
    "reverse-engineering",
    "mcp",
    "binary-analysis"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "rea-agents": "^6.8.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "dsh": ">=0.2.2-rc.2"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
